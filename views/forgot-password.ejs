<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Recuperar Contraseña</title>
    <link rel="stylesheet" href="/stylesheets/recuperar.css">
      <script src="/javascripts/loby.js" defer></script>
  <script src="/javascripts/modoOscuro.js" defer></script>
</head>
<body>
    <div class="container" style="max-width:400px; margin:40px auto;">
        <h2>Recuperar Contraseña</h2>
        <% if (error) { %>
            <div style="color: #b94a48; background: #f2dede; padding: 10px; border-radius: 4px; margin-bottom: 16px;">
                <%= error %>
            </div>
        <% } %>
        <% if (mensaje) { %>
            <div style="color: #145c32; background: #e6f4ea; padding: 10px; border-radius: 4px; margin-bottom: 16px;">
                <%= mensaje %>
            </div>
        <% } %>
        <form action="/forgot-password" method="POST">
            <label for="correo">Correo registrado:</label>
            <input type="email" id="correo" name="correo" required placeholder="Ingresa tu correo">
            <button type="submit" class="btn">Enviar enlace de recuperación</button>
        </form>
        <a href="/login" class="btn" style="margin-top:16px; display:block; text-align:center;">Volver al login</a>
    </div>
</body>
</html>