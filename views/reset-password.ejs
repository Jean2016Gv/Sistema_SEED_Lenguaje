<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Restablecer Contraseña</title>
    <link rel="stylesheet" href="/stylesheets/recuperar.css">
      <script src="/javascripts/loby.js" defer></script>
  <script src="/javascripts/modoOscuro.js" defer></script>
</head>
<body>
    <div class="container" style="max-width:400px; margin:40px auto;">
        <h2>Restablecer Contraseña</h2>
        <% if (error) { %>
            <div style="color: #b94a48; background: #f2dede; padding: 10px; border-radius: 4px; margin-bottom: 16px;">
                <%= error %>
            </div>
        <% } %>
        <form action="/forgot-password/reset-password/<%= token %>" method="POST">
            <label for="password">Nueva contraseña:</label>
            <input type="password" id="password" name="password" required placeholder="Nueva contraseña">
            <button type="submit" class="btn">Cambiar contraseña</button>
        </form>
    </div>
</body>
</html>